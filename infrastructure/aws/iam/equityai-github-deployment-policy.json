{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ECRAuthentication",
            "Effect": "Allow",
            "Action": [
                "ecr:GetAuthorizationToken"
            ],
            "Resource": "*"
        },
        {
            "Sid": "EquityAIECRRepository",
            "Effect": "Allow",
            "Action": [
                "ecr:BatchCheckLayerAvailability",
                "ecr:GetDownloadUrlForLayer",
                "ecr:BatchGetImage",
                "ecr:InitiateLayerUpload",
                "ecr:UploadLayerPart",
                "ecr:CompleteLayerUpload",
                "ecr:PutImage"
            ],
            "Resource": "arn:aws:ecr:eu-west-2:009910376113:repository/equityai-api"
        },
        {
            "Sid": "ECSTaskDefinition",
            "Effect": "Allow",
            "Action": [
                "ecs:RegisterTaskDefinition",
                "ecs:DescribeTaskDefinition"
            ],
            "Resource": "*"
        },
        {
            "Sid": "RunEquityAIMigrationTask",
            "Effect": "Allow",
            "Action": [
                "ecs:RunTask"
            ],
            "Resource": "arn:aws:ecs:eu-west-2:009910376113:task-definition/equityai-api:*"
        },
        {
            "Sid": "DescribeEquityAIMigrationTasks",
            "Effect": "Allow",
            "Action": [
                "ecs:DescribeTasks"
            ],
            "Resource": "*"
        },
        {
            "Sid": "PassECSExecutionRole",
            "Effect": "Allow",
            "Action": [
                "iam:PassRole"
            ],
            "Resource": [
                "arn:aws:iam::009910376113:role/equityaiEcsTaskExecutionRole",
                "arn:aws:iam::009910376113:role/equityaiEcsTaskRole"
            ],
            "Condition": {
                "StringEquals": {
                    "iam:PassedToService": "ecs-tasks.amazonaws.com"
                }
            }
        },
        {
            "Sid": "EquityAIECSServiceDeployment",
            "Effect": "Allow",
            "Action": [
                "ecs:UpdateService",
                "ecs:DescribeServices"
            ],
            "Resource": [
                "arn:aws:ecs:eu-west-2:009910376113:service/equityai-production/equityai-api-service",
                "arn:aws:ecs:eu-west-2:009910376113:service/equityai-production/equityai-ingestion-worker-service-0s739p5o"
            ]
        }
    ]
}
